{
  "expo": {
    "name": "my-gym-partner",
    "slug": "my-gym-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.daniel.mygympartner",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Filmer une série pour revoir ton exécution. La vidéo reste sur ce téléphone.",
          "recordAudioAndroid": false
        }
      ],
      "expo-video"
    ],
    "scheme": "mygympartner",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb4b74b8-3704-4085-99a7-0c95deb9d69b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fb4b74b8-3704-4085-99a7-0c95deb9d69b"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
