{
  "expo": {
    "name": "My Gym Partner",
    "slug": "my-gym-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.daniel.mygympartner",
      "versionCode": 5,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F0D"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Filmer une série pour revoir ton exécution. La vidéo reste sur ce téléphone.",
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir une photo ou une vidéo depuis ta galerie."
        }
      ]
    ],
    "scheme": "mygympartner",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb4b74b8-3704-4085-99a7-0c95deb9d69b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fb4b74b8-3704-4085-99a7-0c95deb9d69b"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
